# tprm.manifest -- ApexAircraftAtmoDemo
# Packing recipe: what you read is what packs (see cmake/apex/Tprm.cmake).
# The master carries the atmosphere-only world, the aircraft + its
# autopilot, and the ACFT/1 bridge configuration.

[components aircraft_atmo]
0x000000  toml/executive.toml
0x000100  toml/scheduler.toml
0x00DC00  toml/earth_body.toml
0x00E000  toml/aircraft.toml
0x00E100  toml/aircraft_controller.toml
0x00CB00  toml/aircraft_bridge.toml

[master master.tprm]
use components aircraft_atmo
