# Bundle manifest (apex_add_bundle_tprms): one bundle per row --
#   <name> <componentId-hex> <role>=<repo-relative-source> [...]
# Roles come from the registered vocabulary (WorldBundle.hpp role
# table); the inner-format suffix rides from the same table. Rules:
# at least one entry per row, roles unique per row, sources exist at
# pack time, duplicate names refused (bundles are shared).
#
# The terrain entry joins earth when the regenerated htile artifact
# lands; role-keyed bundles absorb new entries without consumer
# changes (only the pin moves).
kind world

earth 0x0101 atmosphere=demos/apex_horizon_demo/aircraft_atmo/data/earth_ussa76.atm
