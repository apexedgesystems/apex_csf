# tprm.manifest -- ApexRoverTerrainDemo
# Packing recipe: what you read is what packs (see cmake/apex/Tprm.cmake).
# The master carries the world composition (bodies + probes), the rover,
# and the ROVR/1 bridge configuration.

[components rover_terrain]
0x000000  toml/executive.toml
0x000100  toml/scheduler.toml
0x00DC00  toml/earth_body.toml
0x00DC01  toml/moon_body.toml
0x00DD00  toml/earth_probe.toml
0x00DD01  toml/moon_probe.toml
0x00DE00  toml/earth_rover.toml
0x00CB00  toml/rover_bridge.toml

[master master.tprm]
use components rover_terrain
