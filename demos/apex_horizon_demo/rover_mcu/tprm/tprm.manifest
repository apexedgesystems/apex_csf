# tprm.manifest -- ApexRoverMcuDemo
# Packing recipe: what you read is what packs (see cmake/apex/Tprm.cmake).
# The master carries the shared earth world (embedded bundle entry
# 0x010100: atmosphere + terrain; the rover binds the terrain), the rover
# and its controller, the action engine, the ROVR/2 bridge, and the
# rover_mcu sequence catalog.

[components rover_mcu]
0x000000  toml/executive.toml
0x000100  toml/scheduler.toml
0x000500  toml/action.toml
0x00DC00  toml/earth_body.toml
0x00DE00  toml/earth_rover.toml
0x00E200  toml/rover_controller.toml
0x00CB00  toml/rover_bridge.toml

[sequences rover]
rts 0  toml/rts/rts_001_leg_north.toml
rts 1  toml/rts/rts_002_two_legs_green.toml
rts 2  toml/rts/rts_003_two_legs_strobe.toml
rts 3  toml/rts/rts_004_out_and_back.toml
rts 4  toml/rts/rts_005_guarded_square.toml
rts 5  toml/rts/rts_006_manual_halt.toml
rts 6  toml/rts/rts_007_resume_lights_off.toml
rts 7  toml/rts/rts_009_home.toml
rts 8  toml/rts/rts_032_obstacle_halt.toml
rts 9  toml/rts/rts_033_geofence_halt.toml
rts 10  toml/rts/rts_034_slope_halt.toml

[master master.tprm]
use components rover_mcu
use sequences rover
bundle earth.world.tprm
