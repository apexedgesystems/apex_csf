# tprm.manifest -- ApexOpsDemo
# Packing recipe: what you read is what packs (see cmake/apex/Tprm.cmake).
# The mission bank compiles to the generated tprm/rts/ directory in
# slot naming; sequences load at runtime via file transfer + LOAD_RTS.
# The master carries component configuration only.

[components ops]
0x000000  toml/executive.toml
0x000100  toml/scheduler.toml
0x000400  toml/interface.toml
0x000500  toml/action.toml
0x00C800  toml/system_monitor.toml
0x00C900  toml/telemetry_manager.toml
0x00D000  toml/wave_gen_0.toml
0x00D001  toml/wave_gen_1.toml

[sequences ops]
rts 1  toml/rts/rts_001_noop_sweep.toml
rts 2  toml/rts/rts_002_wave_control.toml

[master master.tprm]
use components ops
