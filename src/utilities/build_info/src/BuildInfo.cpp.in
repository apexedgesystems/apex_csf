/// Bytes of a text of length len that a copy of cap bytes from offset covers.
size_t window(size_t len, size_t offset, size_t cap) noexcept {
  if (offset >= len) {
    return 0;
  }
  const size_t REST = len - offset;
  return REST < cap ? REST : cap;
}

#if defined(__AVR__)
// AVR keeps constants in data memory unless they are placed in program memory,
// and the summary is the one string a firmware reads: it lives in program
// memory and is read through pgmspace into a caller's buffer, so the identity
// costs no static SRAM.
const char SUMMARY[] PROGMEM = "@BI_SUMMARY@";
constexpr bool DIRTY = @BI_DIRTY@;
#else
constexpr const char* const PROJECT = "@BI_PROJECT@";
constexpr const char* const VERSION = "@BI_VERSION@";
constexpr const char* const DESCRIBE = "@BI_DESCRIBE@";
constexpr const char* const COMMIT = "@BI_COMMIT@";
constexpr const char* const BRANCH = "@BI_BRANCH@";
constexpr const char* const TREE_STATE = "@BI_TREE_STATE@";
