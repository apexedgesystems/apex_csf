constexpr const char* const BUILD_TYPE = "@BI_BUILD_TYPE@";
constexpr const char* const COMPILER = "@BI_COMPILER@";
constexpr const char* const TARGET_SYSTEM = "@BI_TARGET_SYSTEM@";
constexpr const char* const SUMMARY = "@BI_SUMMARY@";
#endif

} // namespace

#if defined(__AVR__)

size_t summaryLength() noexcept { return strlen_P(SUMMARY); }

size_t copySummary(char* out, size_t cap, size_t offset) noexcept {
  const size_t N = out == nullptr ? 0 : window(strlen_P(SUMMARY), offset, cap);
  if (N > 0) {
    memcpy_P(out, SUMMARY + offset, N);
  }
  return N;
}

#else

size_t summaryLength() noexcept {
  size_t len = 0;
  while (SUMMARY[len] != '\0') {
    ++len;
  }
  return len;
}

size_t copySummary(char* out, size_t cap, size_t offset) noexcept {
  const size_t N = out == nullptr ? 0 : window(summaryLength(), offset, cap);
  for (size_t i = 0; i < N; ++i) {
    out[i] = SUMMARY[offset + i];
  }
  return N;
}

const char* summary() noexcept { return SUMMARY; }
const char* project() noexcept { return PROJECT; }
const char* version() noexcept { return VERSION; }
const char* describe() noexcept { return DESCRIBE; }
const char* commit() noexcept { return COMMIT; }
